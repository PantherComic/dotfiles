#Swaylock_effects config
#

#Basics
ignore-empty-password
show-failed-attempts
indicator-radius=120
indicator-thickness=15
indicator-idle-visible

# Effects
screenshots
effect-blur=9x5
effect-vignette=0.5:0.5
fade-in=0.3

# Time and Date
clock
timestr=%H:%M
datestr=%d.%m.%y

# Colors
ring-color=111111
inside-color=00000088
text-color=ffffff
line-color=00000000

# Typing
key-hl-color=d90000
ring-ver-color=d90000
inside-ver-color=000000
text-ver-color=ffffff

# Wrong PW
ring-wrong-color=ff1a1a
text-wrong-color=ffffff
inside-wrong-color=000000
